{
  "name": "learning-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "clean": "tsx scripts/clean.ts",
    "clean:dev": "tsx scripts/clean.ts --dev",
    "content:prepare": "tsx scripts/prepare.ts",
    "content:query": "tsx scripts/query.ts",
    "content:spacing:check": "tsx scripts/cjk-spacing.ts --check",
    "content:spacing:scan": "tsx scripts/cjk-spacing.ts --scan",
    "content:spacing:write": "tsx scripts/cjk-spacing.ts --write",
    "typegen": "tsx scripts/typegen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "tsx scripts/format.ts --write",
    "format:check": "tsx scripts/format.ts --check",
    "test": "vitest run",
    "check": "pnpm content:prepare && pnpm typegen && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "verify:artifacts": "tsx scripts/verify-artifacts.ts",
    "preview": "tsx scripts/preview.ts",
    "deploy": "pnpm build && pnpm deploy:private && pnpm deploy:public",
    "deploy:public": "wrangler deploy --config wrangler.public.jsonc",
    "deploy:private": "wrangler deploy --config wrangler.private.jsonc",
    "test:browser": "playwright test",
    "test:deployment": "playwright test --config playwright.deployment.config.ts",
    "test:dev": "playwright test --config playwright.dev.config.ts"
  },
  "dependencies": {
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@radix-ui/react-compose-refs": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clipboard-copy": "^4.0.1",
    "clsx": "^2.1.1",
    "flexsearch": "^0.8.212",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-html": "^9.0.6",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "intl-messageformat": "^12.1.4",
    "katex": "catalog:",
    "lucide-react": "^1.70.0",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.2",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-types": "^2.0.3",
    "motion": "^14.10.0",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-medium-image-zoom": "5.4.9",
    "rehype-expressive-code": "^0.44.3",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tinykeys": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/strictest": "^2.0.8",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
